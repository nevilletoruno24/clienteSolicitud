<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root type="javafx.scene.layout.VBox" spacing="4.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label fx:id="lblTitulo" text="Título de Ventana">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Label fx:id="lblSubtitulo" text="Descripción o instrucción de la ventana." wrapText="true" />
      <Separator />
   </children>
   <padding>
      <Insets bottom="5.0" left="15.0" right="15.0" top="10.0" />
   </padding>
</fx:root>
