<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import uam.com.ni.clientesolicitud.components.HeaderComponent?>

<BorderPane prefHeight="550.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uam.com.ni.clientesolicitud.controller.ConsultaClientesController">
   <top>
      <HeaderComponent titulo="Consulta y Catálogo de Clientes" subtitulo="Doble clic sobre una fila para ver el detalle completo del cliente seleccionado." />
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <!-- Barra de búsqueda y acciones -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Buscar:" />
                  <TextField fx:id="txtBuscar" prefWidth="260.0" promptText="Nombre, tipo, ciudad o solicitud..." />
                  <Label fx:id="lblContador" text="Mostrando clientes" />
                  <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onNuevoClienteAction" text="Nuevo Cliente" />
                        <Button mnemonicParsing="false" onAction="#onVerDetalleAction" text="Ver Detalle" />
                        <Button mnemonicParsing="false" onAction="#onEliminarClienteAction" text="Eliminar" />
                     </children>
                  </HBox>
               </children>
            </HBox>
            <!-- TableView -->
            <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="Código" />
                <TableColumn fx:id="colNombreCompleto" prefWidth="180.0" text="Nombre Completo" />
                <TableColumn fx:id="colTipoCliente" prefWidth="100.0" text="Tipo Cliente" />
                <TableColumn fx:id="colCiudad" prefWidth="95.0" text="Ciudad" />
                <TableColumn fx:id="colFechaNacimiento" prefWidth="110.0" text="F. Nacimiento" />
                <TableColumn fx:id="colTipoSolicitud" prefWidth="130.0" text="Tipo Solicitud" />
                <TableColumn fx:id="colServicios" prefWidth="170.0" text="Servicios" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <contextMenu>
                  <ContextMenu>
                    <items>
                      <MenuItem mnemonicParsing="false" onAction="#onVerDetalleAction" text="Ver Detalle del Cliente" />
                      <MenuItem mnemonicParsing="false" onAction="#onEliminarClienteAction" text="Eliminar Registro" />
                    </items>
                  </ContextMenu>
               </contextMenu>
            </TableView>
         </children>
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <Separator />
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Atajos: ENTER (Detalle) | DELETE (Eliminar) | ESC (Menú Principal)" />
                     </children>
                  </HBox>
                  <Button mnemonicParsing="false" onAction="#onVolverMenuAction" prefWidth="160.0" text="Volver al Menú" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
