<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="640.0" prefWidth="920.0"
            style="-fx-background-color: #F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uam.com.ni.clientesolicitud.controller.ConsultaClientesController">

    <!-- Encabezado con Botón de Regreso y Acción Primaria -->
    <top>
        <VBox style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 14px 28px;">
                <Button mnemonicParsing="false" onAction="#onVolverMenuAction"
                        text="Volver al Panel Principal"
                        style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #334155; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7px 14px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="fas-arrow-left" iconSize="13" iconColor="#475569"/>
                    </graphic>
                </Button>

                <Separator orientation="VERTICAL" maxHeight="24.0"/>

                <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="Catálogo y Consulta de Clientes"
                           style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                    <Label text="Búsqueda interactiva, filtrado dinámico y revisión de expedientes."
                           style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                </VBox>

                <Button mnemonicParsing="false" onAction="#onNuevoClienteAction"
                        text="Nuevo Cliente"
                        style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #2563EB; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-text-fill: #FFFFFF; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8px 16px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="fas-plus" iconSize="12" iconColor="#FFFFFF"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <!-- Contenido Central: Buscador y Tabla -->
    <center>
        <VBox spacing="14.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="28.0" right="28.0" top="18.0"/>
            </padding>

            <!-- Barra de búsqueda y contador -->
            <HBox alignment="CENTER_LEFT" spacing="14.0"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-border-width: 1px; -fx-padding: 10px 16px;">
                <FontIcon iconLiteral="fas-search" iconSize="14" iconColor="#94A3B8"/>
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre, código, ciudad o solicitud..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: transparent; -fx-font-size: 13px; -fx-text-fill: #0F172A; -fx-prompt-text-fill: #94A3B8;"/>
                <Separator orientation="VERTICAL" maxHeight="18.0"/>
                <Label fx:id="lblContador" text="Cargando registros..."
                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
            </HBox>

            <!-- TableView -->
            <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-border-width: 1px;">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="85.0" text="Código"/>
                    <TableColumn fx:id="colNombreCompleto" prefWidth="190.0" text="Nombre Completo"/>
                    <TableColumn fx:id="colTipoCliente" prefWidth="105.0" text="Tipo Cliente"/>
                    <TableColumn fx:id="colCiudad" prefWidth="100.0" text="Ciudad"/>
                    <TableColumn fx:id="colFechaNacimiento" prefWidth="110.0" text="F. Nacimiento"/>
                    <TableColumn fx:id="colTipoSolicitud" prefWidth="135.0" text="Tipo Solicitud"/>
                    <TableColumn fx:id="colServicios" prefWidth="175.0" text="Servicios"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem mnemonicParsing="false" onAction="#onVerDetalleAction" text="Ver Expediente del Cliente"/>
                            <MenuItem mnemonicParsing="false" onAction="#onEliminarClienteAction" text="Eliminar Registro"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
            </TableView>

            <!-- Barra Inferior de Acciones sobre Selección -->
            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-border-width: 1px; -fx-padding: 10px 16px;">
                <Label text="Atajos: ENTER (Ver Detalle) • DELETE (Eliminar) • ESC (Volver)"
                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>

                <HBox alignment="CENTER_RIGHT" spacing="12.0" HBox.hgrow="ALWAYS">
                    <Button mnemonicParsing="false" onAction="#onEliminarClienteAction"
                            text="Eliminar"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #FEF2F2; -fx-border-color: #FECACA; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-text-fill: #DC2626; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6px 14px; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-trash-alt" iconSize="12" iconColor="#DC2626"/>
                        </graphic>
                    </Button>

                    <Button mnemonicParsing="false" onAction="#onVerDetalleAction"
                            text="Ver Expediente Detallado"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #EFF6FF; -fx-border-color: #DBEAFE; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-text-fill: #2563EB; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6px 16px; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-id-card" iconSize="13" iconColor="#2563EB"/>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>
