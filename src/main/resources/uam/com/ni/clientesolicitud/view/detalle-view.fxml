<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="640.0" prefWidth="920.0"
            style="-fx-background-color: #F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uam.com.ni.clientesolicitud.controller.DetalleClienteController">

    <!-- Encabezado con Botón de Regreso -->
    <top>
        <VBox style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 14px 28px;">
                <Button fx:id="btnVolverConsulta" mnemonicParsing="false" onAction="#onVolverConsultaAction"
                        text="Volver al Catálogo"
                        style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #334155; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7px 14px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="fas-arrow-left" iconSize="13" iconColor="#475569"/>
                    </graphic>
                </Button>

                <Separator orientation="VERTICAL" maxHeight="24.0"/>

                <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="Expediente de Cliente:"
                               style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                        <Label fx:id="lblCodigo" text="CLI-0000"
                               style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                    </HBox>
                    <Label text="Consulta detallada de información y actualización de observaciones."
                           style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- Contenido Central: Ficha del Cliente -->
    <center>
        <VBox spacing="18.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="28.0" right="28.0" top="20.0"/>
            </padding>

            <!-- Tarjeta de Información General y Fotografía -->
            <VBox spacing="16.0"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-padding: 22px;">
                <HBox spacing="24.0">
                    <!-- Datos en Formato Ficha -->
                    <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                        <GridPane hgap="14.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="130.0" prefWidth="140.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="280.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="26.0" prefHeight="26.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="26.0" prefHeight="26.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="26.0" prefHeight="26.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="26.0" prefHeight="26.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="26.0" prefHeight="26.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="65.0" prefHeight="65.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="26.0" prefHeight="26.0" vgrow="SOMETIMES"/>
                            </rowConstraints>
                                <Label text="Nombre Completo:"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                                <Label fx:id="lblNombreCompleto" text="-" GridPane.columnIndex="1"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

                                <Label text="Tipo de Cliente:" GridPane.rowIndex="1"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                                <Label fx:id="lblTipoCliente" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #1E293B;"/>

                                <Label text="Ciudad:" GridPane.rowIndex="2"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                                <Label fx:id="lblCiudad" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #1E293B;"/>

                                <Label text="Fecha Nacimiento:" GridPane.rowIndex="3"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                                <Label fx:id="lblFechaNacimiento" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #1E293B;"/>

                                <Label text="Tipo de Solicitud:" GridPane.rowIndex="4"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                                <Label fx:id="lblTipoSolicitud" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>

                                <Label text="Servicios de Interés:" GridPane.rowIndex="5" GridPane.valignment="TOP"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                                <ListView fx:id="lstServicios" prefHeight="65.0" GridPane.columnIndex="1" GridPane.rowIndex="5"
                                          style="-fx-background-color: #F8FAFC; -fx-background-radius: 6px; -fx-border-color: #CBD5E1; -fx-border-radius: 6px;"/>

                                <Label text="Fecha de Registro:" GridPane.rowIndex="6"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                                <Label fx:id="lblFechaRegistro" text="-" GridPane.columnIndex="1" GridPane.rowIndex="6"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                        </GridPane>
                    </VBox>

                    <!-- Fotografía -->
                    <VBox alignment="CENTER" maxWidth="180.0" minWidth="170.0" spacing="10.0"
                          style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-border-width: 1px; -fx-padding: 14px;">
                        <Label text="Fotografía del Titular"
                               style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                        <StackPane maxHeight="130.0" maxWidth="130.0" minHeight="130.0" minWidth="130.0"
                                   style="-fx-background-color: #FFFFFF; -fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-border-width: 1px;">
                            <ImageView fx:id="imgFoto" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true"/>
                        </StackPane>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Sección de Observaciones y Edición -->
            <VBox spacing="10.0" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-padding: 20px;">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Observaciones de la Solicitud"
                           style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                    <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                        <Button mnemonicParsing="false" onAction="#onEditarConDialogAction"
                                text="Editar con Diálogo (Dialog)..."
                                style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-text-fill: #334155; -fx-font-size: 12px; -fx-padding: 6px 12px; -fx-cursor: hand;">
                            <graphic>
                                <FontIcon iconLiteral="fas-edit" iconSize="12" iconColor="#475569"/>
                            </graphic>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#onGuardarCambiosAction"
                                text="Guardar Observación"
                                style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #2563EB; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-text-fill: #FFFFFF; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6px 14px; -fx-cursor: hand;">
                            <graphic>
                                <FontIcon iconLiteral="fas-save" iconSize="12" iconColor="#FFFFFF"/>
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>

                <TextArea fx:id="txtObservaciones" prefRowCount="3" promptText="Sin observaciones registradas..." wrapText="true"
                          VBox.vgrow="ALWAYS"
                          style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #F8FAFC; -fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-font-size: 13px;"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>
