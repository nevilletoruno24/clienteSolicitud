<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import uam.com.ni.clientesolicitud.components.CustomInput?>

<StackPane prefHeight="560.0" prefWidth="580.0"
           style="-fx-background-color: #F1F5F9;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="uam.com.ni.clientesolicitud.controller.LoginController">

    <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
        </padding>

        <VBox spacing="22.0"
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 14px; -fx-border-color: #E2E8F0; -fx-border-radius: 14px; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.08), 22, 0.0, 0, 6); -fx-padding: 36px 32px;">

            <VBox alignment="CENTER" spacing="10.0">
                <StackPane maxHeight="48.0" maxWidth="48.0" minHeight="48.0" minWidth="48.0"
                           style="-fx-background-color: #EFF6FF; -fx-background-radius: 24px; -fx-border-color: #DBEAFE; -fx-border-radius: 24px; -fx-border-width: 1px;">
                    <FontIcon iconLiteral="fas-lock" iconSize="22" iconColor="#2563EB"/>
                </StackPane>
                <Label text="Inicio de Sesión"
                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                <Label text="Ingrese sus credenciales para acceder al sistema" textAlignment="CENTER" wrapText="true"
                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #64748B;"/>
            </VBox>

            <VBox spacing="16.0">
                <CustomInput fx:id="inputUsuario" labelText="Usuario" promptText="Ingrese su usuario"/>
                <CustomInput fx:id="inputPassword" labelText="Contraseña" promptText="••••••••" isPassword="true"/>
            </VBox>

            <HBox spacing="12.0">
                <VBox.margin>
                    <Insets top="8.0"/>
                </VBox.margin>
                <Button cancelButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#onSalirAction"
                        prefHeight="42.0" text="Salir" HBox.hgrow="ALWAYS"
                        style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #475569; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#onIniciarSesionAction"
                        prefHeight="42.0" text="Iniciar Sesión" HBox.hgrow="ALWAYS"
                        style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #2563EB; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>

            <HBox fx:id="boxError" alignment="CENTER_LEFT" managed="false" spacing="10.0" visible="false"
                  style="-fx-background-color: #FEF2F2; -fx-border-color: #FECACA; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 10px 14px;">
                <FontIcon iconLiteral="fas-exclamation-circle" iconSize="16" iconColor="#DC2626"/>
                <Label fx:id="lblError" text="Mensaje de validación" wrapText="true"
                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
            </HBox>
        </VBox>

        <Label text="Sistema de Gestión de Clientes y Solicitudes • Acceso Seguro"
               style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
    </VBox>
</StackPane>
