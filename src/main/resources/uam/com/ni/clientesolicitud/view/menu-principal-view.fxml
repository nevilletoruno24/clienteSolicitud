<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import uam.com.ni.clientesolicitud.components.StatCardComponent?>

<BorderPane prefHeight="640.0" prefWidth="920.0"
            style="-fx-background-color: #F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uam.com.ni.clientesolicitud.controller.MenuPrincipalController"
            onContextMenuRequested="#onContextMenuRequested">

    <fx:define>
        <ContextMenu fx:id="contextMenu">
            <items>
                <MenuItem text="Registrar Nuevo Cliente" onAction="#onRegistrarClienteAction">
                    <graphic>
                        <FontIcon iconLiteral="fas-user-plus" iconSize="13" iconColor="#2563EB"/>
                    </graphic>
                </MenuItem>
                <MenuItem text="Consultar Catálogo de Clientes" onAction="#onConsultarClientesAction">
                    <graphic>
                        <FontIcon iconLiteral="fas-table" iconSize="13" iconColor="#4F46E5"/>
                    </graphic>
                </MenuItem>
                <SeparatorMenuItem/>
                <MenuItem text="Actualizar Métricas" onAction="#onActualizarMetricasAction">
                    <graphic>
                        <FontIcon iconLiteral="fas-sync-alt" iconSize="13" iconColor="#2563EB"/>
                    </graphic>
                </MenuItem>
                <MenuItem text="Exportar Catálogo a CSV" onAction="#onExportarDirectorioAction">
                    <graphic>
                        <FontIcon iconLiteral="fas-file-export" iconSize="13" iconColor="#0D9488"/>
                    </graphic>
                </MenuItem>
                <SeparatorMenuItem/>
                <MenuItem text="Cerrar Sesión" onAction="#onCerrarSesionAction">
                    <graphic>
                        <FontIcon iconLiteral="fas-sign-out-alt" iconSize="13" iconColor="#64748B"/>
                    </graphic>
                </MenuItem>
            </items>
        </ContextMenu>
    </fx:define>

    <!-- Encabezado Superior Principal con MenuBar y ToolBar -->
    <top>
        <VBox style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <MenuBar style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px;">
                <menus>
                    <Menu text="Archivo">
                        <items>
                            <MenuItem text="Nuevo Cliente" onAction="#onRegistrarClienteAction">
                                <graphic>
                                    <FontIcon iconLiteral="fas-user-plus" iconSize="13" iconColor="#2563EB"/>
                                </graphic>
                            </MenuItem>
                            <MenuItem text="Consultar Catálogo" onAction="#onConsultarClientesAction">
                                <graphic>
                                    <FontIcon iconLiteral="fas-table" iconSize="13" iconColor="#4F46E5"/>
                                </graphic>
                            </MenuItem>
                            <SeparatorMenuItem/>
                            <MenuItem text="Exportar Catálogo a CSV..." onAction="#onExportarDirectorioAction">
                                <graphic>
                                    <FontIcon iconLiteral="fas-file-export" iconSize="13" iconColor="#0D9488"/>
                                </graphic>
                            </MenuItem>
                            <SeparatorMenuItem/>
                            <MenuItem text="Cerrar Sesión" onAction="#onCerrarSesionAction">
                                <graphic>
                                    <FontIcon iconLiteral="fas-sign-out-alt" iconSize="13" iconColor="#64748B"/>
                                </graphic>
                            </MenuItem>
                            <MenuItem text="Salir" onAction="#onSalirAction">
                                <graphic>
                                    <FontIcon iconLiteral="fas-power-off" iconSize="13" iconColor="#DC2626"/>
                                </graphic>
                            </MenuItem>
                        </items>
                    </Menu>
                    <Menu text="Herramientas">
                        <items>
                            <MenuItem text="Actualizar Métricas" onAction="#onActualizarMetricasAction">
                                <graphic>
                                    <FontIcon iconLiteral="fas-sync-alt" iconSize="13" iconColor="#2563EB"/>
                                </graphic>
                            </MenuItem>
                        </items>
                    </Menu>
                    <Menu text="Ayuda">
                        <items>
                            <MenuItem text="Acerca de..." onAction="#onAcercaDeAction">
                                <graphic>
                                    <FontIcon iconLiteral="fas-info-circle" iconSize="13" iconColor="#64748B"/>
                                </graphic>
                            </MenuItem>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 14px 28px;">
                <StackPane maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0"
                           style="-fx-background-color: #EFF6FF; -fx-background-radius: 10px; -fx-border-color: #DBEAFE; -fx-border-radius: 10px; -fx-border-width: 1px;">
                    <FontIcon iconLiteral="fas-cubes" iconSize="20" iconColor="#2563EB"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="Sistema de Gestión de Clientes y Solicitudes"
                           style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                    <Label text="Panel de Control Principal"
                           style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                </VBox>

                <!-- Estado del Usuario y Cerrar Sesión -->
                <HBox alignment="CENTER" spacing="12.0">
                    <HBox alignment="CENTER" spacing="6.0"
                          style="-fx-background-color: #F1F5F9; -fx-background-radius: 20px; -fx-padding: 6px 12px;">
                        <StackPane maxHeight="8.0" maxWidth="8.0" minHeight="8.0" minWidth="8.0"
                                   style="-fx-background-color: #16A34A; -fx-background-radius: 4px;"/>
                        <Label text="Admin (En línea)"
                               style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                    </HBox>

                    <Button mnemonicParsing="false" onAction="#onCerrarSesionAction"
                            text="Cerrar Sesión"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6px 14px; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-sign-out-alt" iconSize="13" iconColor="#64748B"/>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>

            <ToolBar style="-fx-background-color: #FAFAFA; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 6px 28px;">
                <items>
                    <Button mnemonicParsing="false" onAction="#onRegistrarClienteAction" text="Nuevo Cliente"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-text-fill: #1E293B; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5px 12px; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-user-plus" iconSize="12" iconColor="#2563EB"/>
                        </graphic>
                    </Button>
                    <Button mnemonicParsing="false" onAction="#onConsultarClientesAction" text="Catálogo"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-text-fill: #1E293B; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5px 12px; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-table" iconSize="12" iconColor="#4F46E5"/>
                        </graphic>
                    </Button>
                    <Separator orientation="VERTICAL" maxHeight="18.0"/>
                    <Button mnemonicParsing="false" onAction="#onExportarDirectorioAction" text="Exportar CSV"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-text-fill: #334155; -fx-font-size: 12px; -fx-padding: 5px 12px; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-file-export" iconSize="12" iconColor="#0D9488"/>
                        </graphic>
                    </Button>
                    <Button mnemonicParsing="false" onAction="#onActualizarMetricasAction" text="Actualizar"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-text-fill: #334155; -fx-font-size: 12px; -fx-padding: 5px 12px; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-sync-alt" iconSize="12" iconColor="#2563EB"/>
                        </graphic>
                    </Button>
                </items>
            </ToolBar>
        </VBox>
    </top>

    <!-- Contenido Central: Métricas y Módulos -->
    <center>
        <VBox spacing="24.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="24.0"/>
            </padding>

            <!-- Sección de Métricas -->
            <VBox spacing="10.0">
                <Label text="Resumen General"
                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #64748B; -fx-text-transform: uppercase;"/>

                <GridPane hgap="16.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="25.0"/>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="25.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="85.0" prefHeight="85.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <StackPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.04), 10, 0, 0, 2); -fx-padding: 14px;">
                        <StatCardComponent fx:id="cardTotal" tituloMetrica="Total Clientes" valorMetrica="0"/>
                    </StackPane>
                    <StackPane GridPane.columnIndex="1"
                               style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.04), 10, 0, 0, 2); -fx-padding: 14px;">
                        <StatCardComponent fx:id="cardCreditos" tituloMetrica="Créditos" valorMetrica="0"/>
                    </StackPane>
                    <StackPane GridPane.columnIndex="2"
                               style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.04), 10, 0, 0, 2); -fx-padding: 14px;">
                        <StatCardComponent fx:id="cardCuentas" tituloMetrica="Cuentas" valorMetrica="0"/>
                    </StackPane>
                    <StackPane GridPane.columnIndex="3"
                               style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.04), 10, 0, 0, 2); -fx-padding: 14px;">
                        <StatCardComponent fx:id="cardReclamos" tituloMetrica="Reclamos / Soporte" valorMetrica="0"/>
                    </StackPane>
                </GridPane>
            </VBox>

            <!-- Sección de Módulos Principales (2 Cards Hero) -->
            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                <Label text="Módulos de Trabajo"
                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #64748B; -fx-text-transform: uppercase;"/>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <!-- Módulo 1: Registrar Nuevo Cliente -->
                    <VBox spacing="16.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 14px; -fx-border-color: #E2E8F0; -fx-border-radius: 14px; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.05), 14, 0, 0, 4); -fx-padding: 24px;">
                        <StackPane maxHeight="52.0" maxWidth="52.0" minHeight="52.0" minWidth="52.0"
                                   style="-fx-background-color: #EFF6FF; -fx-background-radius: 12px; -fx-border-color: #DBEAFE; -fx-border-radius: 12px; -fx-border-width: 1px;">
                            <FontIcon iconLiteral="fas-user-plus" iconSize="24" iconColor="#2563EB"/>
                        </StackPane>

                        <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                            <Label text="Registrar Nuevo Cliente"
                                   style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                            <Label text="Formulario estructurado para el registro de datos personales, ubicación, solicitud de crédito, cuentas o soporte, servicios de interés y fotografía."
                                   wrapText="true"
                                   style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #64748B; -fx-line-spacing: 2px;"/>
                        </VBox>

                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onRegistrarClienteAction"
                                prefHeight="42.0" text="Abrir Formulario de Registro →"
                                style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #2563EB; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>

                    <!-- Módulo 2: Catálogo y Consulta -->
                    <VBox spacing="16.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 14px; -fx-border-color: #E2E8F0; -fx-border-radius: 14px; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.05), 14, 0, 0, 4); -fx-padding: 24px;">
                        <StackPane maxHeight="52.0" maxWidth="52.0" minHeight="52.0" minWidth="52.0"
                                   style="-fx-background-color: #EEF2FF; -fx-background-radius: 12px; -fx-border-color: #E0E7FF; -fx-border-radius: 12px; -fx-border-width: 1px;">
                            <FontIcon iconLiteral="fas-table" iconSize="24" iconColor="#4F46E5"/>
                        </StackPane>

                        <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                            <Label text="Catálogo y Expedientes"
                                   style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                            <Label text="Visualización tabular del catálogo completo de clientes, búsqueda en tiempo real, consulta del expediente detallado con paso de datos y eliminación de registros."
                                   wrapText="true"
                                   style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #64748B; -fx-line-spacing: 2px;"/>
                        </VBox>

                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onConsultarClientesAction"
                                prefHeight="42.0" text="Consultar Catálogo de Clientes →"
                                style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #4F46E5; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Herramientas Secundarias en Barra Inferior -->
            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-border-width: 1px; -fx-padding: 10px 16px;">
                <Label text="Herramientas Rápidas:"
                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>

                <Button mnemonicParsing="false" onAction="#onExportarDirectorioAction"
                        text="Exportar Catálogo a CSV"
                        style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-text-fill: #334155; -fx-font-size: 12px; -fx-padding: 6px 12px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="fas-file-export" iconSize="13" iconColor="#2563EB"/>
                    </graphic>
                </Button>

                <HBox alignment="CENTER_RIGHT" spacing="12.0" HBox.hgrow="ALWAYS">
                    <Button mnemonicParsing="false" onAction="#onAcercaDeAction"
                            text="Acerca de"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 12px; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-info-circle" iconSize="13" iconColor="#64748B"/>
                        </graphic>
                    </Button>
                    <Separator orientation="VERTICAL" maxHeight="18.0"/>
                    <Button mnemonicParsing="false" onAction="#onSalirAction"
                            text="Salir"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: transparent; -fx-text-fill: #DC2626; -fx-font-size: 12px; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-power-off" iconSize="13" iconColor="#DC2626"/>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>
