<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="640.0" prefWidth="920.0"
            style="-fx-background-color: #F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uam.com.ni.clientesolicitud.controller.RegistroClienteController">

    <!-- Encabezado con Botón de Regreso -->
    <top>
        <VBox style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 14px 28px;">
                <Button mnemonicParsing="false" onAction="#onCancelarAction"
                        text="Volver al Panel Principal"
                        style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #334155; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7px 14px; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="fas-arrow-left" iconSize="13" iconColor="#475569"/>
                    </graphic>
                </Button>

                <Separator orientation="VERTICAL" maxHeight="24.0"/>

                <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblTituloPantalla" text="Registro de Nuevo Cliente y Solicitud"
                           style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                    <Label fx:id="lblSubtituloPantalla" text="Complete la información del cliente y configure los detalles de su solicitud."
                           style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- Contenido del Formulario en ScrollPane -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F8FAFC; -fx-border-color: transparent;">
            <VBox spacing="18.0">
                <padding>
                    <Insets bottom="24.0" left="28.0" right="28.0" top="20.0"/>
                </padding>

                <!-- Sección 1: Datos Personales y Fotografía -->
                <VBox spacing="16.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-padding: 22px;">
                    <Label text="1. DATOS PERSONALES Y UBICACIÓN"
                           style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-letter-spacing: 0.5px;"/>

                    <HBox spacing="24.0">
                        <!-- Campos de Texto -->
                        <GridPane hgap="14.0" vgap="12.0" HBox.hgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="130.0" prefWidth="140.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="280.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="36.0" prefHeight="36.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="36.0" prefHeight="36.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="36.0" prefHeight="36.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="36.0" prefHeight="36.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="36.0" prefHeight="36.0" vgrow="SOMETIMES"/>
                            </rowConstraints>
                            <Label text="Nombres: *"
                                   style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <TextField fx:id="txtNombres" promptText="Solo letras (ej. Carlos Alberto)"
                                       GridPane.columnIndex="1"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #F8FAFC; -fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 8px 12px; -fx-font-size: 13px;"/>

                            <Label text="Apellidos: *" GridPane.rowIndex="1"
                                   style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <TextField fx:id="txtApellidos" promptText="Solo letras (ej. Mendoza Solís)"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"
                                       style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #F8FAFC; -fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-padding: 8px 12px; -fx-font-size: 13px;"/>

                            <Label text="Tipo de Cliente: *" GridPane.rowIndex="2"
                                   style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <ComboBox fx:id="cmbTipoCliente" maxWidth="Infinity" promptText="Seleccione tipo..."
                                      GridPane.columnIndex="1" GridPane.rowIndex="2"
                                      style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-font-size: 13px;"/>

                            <Label text="Ciudad: *" GridPane.rowIndex="3"
                                   style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <ComboBox fx:id="cmbCiudad" maxWidth="Infinity" promptText="Seleccione ciudad..."
                                      GridPane.columnIndex="1" GridPane.rowIndex="3"
                                      style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-font-size: 13px;"/>

                            <Label text="Fecha Nacimiento: *" GridPane.rowIndex="4"
                                   style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <DatePicker fx:id="dpFechaNacimiento" maxWidth="Infinity" promptText="dd/mm/aaaa"
                                        GridPane.columnIndex="1" GridPane.rowIndex="4"
                                        style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px;"/>
                        </GridPane>

                        <!-- Selector de Foto -->
                        <VBox alignment="CENTER" maxWidth="180.0" minWidth="170.0" spacing="10.0"
                              style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-border-width: 1px; -fx-padding: 14px;">
                            <Label text="Fotografía del Cliente"
                                   style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>

                            <StackPane maxHeight="120.0" maxWidth="120.0" minHeight="120.0" minWidth="120.0"
                                       style="-fx-background-color: #FFFFFF; -fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-border-width: 1px;">
                                <ImageView fx:id="imgFoto" fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true"/>
                            </StackPane>

                            <Button fx:id="btnSeleccionarFoto" maxWidth="Infinity" mnemonicParsing="false"
                                    onAction="#onSeleccionarFotoAction" text="Cargar Foto..."
                                    style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-text-fill: #334155; -fx-font-size: 12px; -fx-cursor: hand;">
                                <graphic>
                                    <FontIcon iconLiteral="fas-camera" iconSize="12" iconColor="#64748B"/>
                                </graphic>
                            </Button>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Sección 2: Solicitud y Preferencias -->
                <VBox spacing="16.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12px; -fx-border-color: #E2E8F0; -fx-border-radius: 12px; -fx-border-width: 1px; -fx-padding: 22px;">
                    <Label text="2. DETALLES DE LA SOLICITUD Y SERVICIOS"
                           style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-letter-spacing: 0.5px;"/>

                    <!-- Tipo de Solicitud -->
                    <VBox spacing="8.0">
                        <Label text="Tipo de Solicitud: *"
                               style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                        <HBox spacing="24.0">
                            <RadioButton fx:id="rbCredito" mnemonicParsing="false" selected="true" text="Crédito Personal"
                                         style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #1E293B;">
                                <toggleGroup>
                                    <ToggleGroup fx:id="tgTipoSolicitud"/>
                                </toggleGroup>
                            </RadioButton>
                            <RadioButton mnemonicParsing="false" text="Apertura de Cuenta" toggleGroup="$tgTipoSolicitud"
                                         style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #1E293B;"/>
                            <RadioButton mnemonicParsing="false" text="Reclamo de Servicio" toggleGroup="$tgTipoSolicitud"
                                         style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #1E293B;"/>
                            <RadioButton mnemonicParsing="false" text="Soporte Técnico" toggleGroup="$tgTipoSolicitud"
                                         style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #1E293B;"/>
                        </HBox>
                    </VBox>

                    <!-- Servicios de Interés -->
                    <VBox spacing="8.0">
                        <Label text="Servicios de Interés Adicionales:"
                               style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                        <HBox spacing="24.0">
                            <CheckBox fx:id="chkBancaLinea" mnemonicParsing="false" text="Banca en Línea"
                                      style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #1E293B;"/>
                            <CheckBox fx:id="chkTarjetaCredito" mnemonicParsing="false" text="Tarjeta de Crédito"
                                      style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #1E293B;"/>
                            <CheckBox fx:id="chkSeguroVida" mnemonicParsing="false" text="Seguro de Vida"
                                      style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #1E293B;"/>
                            <CheckBox fx:id="chkAsesoria" mnemonicParsing="false" text="Asesoría Financiera"
                                      style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-text-fill: #1E293B;"/>
                        </HBox>
                    </VBox>

                    <!-- Observaciones -->
                    <VBox spacing="6.0">
                        <Label text="Observaciones Adicionales:"
                               style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                        <TextArea fx:id="txtObservaciones" prefRowCount="2" promptText="Ingrese cualquier nota relevante para el expediente..." wrapText="true"
                                  style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #F8FAFC; -fx-background-radius: 8px; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-font-size: 13px;"/>
                    </VBox>
                </VBox>

                <!-- Barra de Acciones del Formulario -->
                <HBox alignment="CENTER_RIGHT" spacing="14.0">
                    <Button fx:id="btnCancelar" cancelButton="true" mnemonicParsing="false" onAction="#onCancelarAction"
                            prefHeight="38.0" prefWidth="120.0" text="Cancelar"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>

                    <Button mnemonicParsing="false" onAction="#onLimpiarAction"
                            prefHeight="38.0" prefWidth="120.0" text="Limpiar"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>

                    <Button fx:id="btnGuardar" defaultButton="true" mnemonicParsing="false" onAction="#onGuardarAction"
                            prefHeight="38.0" prefWidth="160.0" text="Guardar Cliente"
                            style="-fx-font-family: 'Segoe UI', -apple-system, sans-serif; -fx-background-color: #2563EB; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;">
                        <graphic>
                            <FontIcon iconLiteral="fas-check" iconSize="13" iconColor="#FFFFFF"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
